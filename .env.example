# Copy this file to .env (which is gitignored) before running docker compose.
# These are local-only dev credentials - never used outside your machine.

POSTGRES_USER=dropbox
POSTGRES_PASSWORD=dropbox_dev_password
POSTGRES_DB=dropbox

MINIO_ROOT_USER=dropbox_admin
MINIO_ROOT_PASSWORD=dropbox_dev_password

# Shared secret MinIO sends back on its webhook calls to Dropbox.Api, so the
# webhook endpoint can reject forged "upload complete" notifications.
# Generate your own with: openssl rand -base64 32
STORAGE_WEBHOOK_SECRET=change-me

# Only needed when Dropbox.Api runs containerized (docker compose). When run
# via `dotnet run` on the host, the app reads this from User Secrets instead.
# Generate your own with: openssl rand -base64 32
JWT_SIGNING_KEY=change-me
